generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Comment {
  id      String @id @default(uuid())
  content String
  score   Int    @default(0)

  createdAt DateTime @default(now())

  parentId String
  userId   String
  postId   String

  upvotes Vote[]
}

model Vote {
  id    String @id @default(uuid())
  value Int

  commentId String
  userId    String

  comment Comment @relation(fields: [commentId], references: [id])

  @@unique([commentId, userId])
}


