{
  "name": "@belfed/koemment",
  "type": "module",
  "version": "0.2.1",
  "description": "Client for reading and writing comments via the koemment API.",
  "author": "belfed",
  "license": "MIT",
  "homepage": "https://github.com/belfed/koemment#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belfed/koemment.git"
  },
  "bugs": {
